\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 单个 \texttt  {funnel} 算例上的收敛曲线（取自含三个算例的诊断批次），横轴为挂钟时间，曲线为三个种子的逐时刻均值， 阴影带为种子间的\emph  {全距}（样本量不足以估计四分位数）。 实线（B1、B2）始终为可实现的完工时间；虚线为开环搜索的代理目标，即其实际优化的量； 叉号与十字标出同一计划经无冲突路由执行后的完工时间。 虚线终点与叉号之差即该算例的乐观幅度：开环并非收敛不充分，而是收敛到不可实现的代理目标。 本图为示意，不支撑统计结论（统计以 $10$ 组 $\times $ $10$ 个种子的主批次为准）；挂钟预算为 $46.3$ 秒，与主批次的 $90$ 秒不同。}}{22}{figure.caption.22}\protected@file@percent }
\newlabel{fig:convergence}{{3}{22}{单个 \texttt {funnel} 算例上的收敛曲线（取自含三个算例的诊断批次），横轴为挂钟时间，曲线为三个种子的逐时刻均值， 阴影带为种子间的\emph {全距}（样本量不足以估计四分位数）。 实线（B1、B2）始终为可实现的完工时间；虚线为开环搜索的代理目标，即其实际优化的量； 叉号与十字标出同一计划经无冲突路由执行后的完工时间。 虚线终点与叉号之差即该算例的乐观幅度：开环并非收敛不充分，而是收敛到不可实现的代理目标。 本图为示意，不支撑统计结论（统计以 $\NCases $ 组 $\times $ $\NSeeds $ 个种子的主批次为准）；挂钟预算为 $46.3$ 秒，与主批次的 $90$ 秒不同。}{figure.caption.22}{}}
