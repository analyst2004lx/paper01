\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 同一漏斗算例上 B0（上）与 B2（下）。机械臂与车辆共用时间轴；车辆行区分空载、满载，以及两类空隙。 同一运输任务两段之间的空隙：车被已占用的走廊拦在停靠位上，即让行，也就是本文处理的那种延误。 不同任务之间的空隙：车无活可干。二者分色，以免把空闲读成让行。}}{31}{figure.caption.43}\protected@file@percent }
\newlabel{fig:case_gantt}{{8}{31}{同一漏斗算例上 B0（上）与 B2（下）。机械臂与车辆共用时间轴；车辆行区分空载、满载，以及两类空隙。 同一运输任务两段之间的空隙：车被已占用的走廊拦在停靠位上，即让行，也就是本文处理的那种延误。 不同任务之间的空隙：车无活可干。二者分色，以免把空闲读成让行。}{figure.caption.43}{}}
\@writefile{toc}{\contentsline {paragraph}{间隙主要是搜索能力，不是预算不够。}{31}{section*.49}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{复合下界与最好解的间隙从哪里来。}{31}{section*.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 关键链各节按表\nonbreakingspace \ref {tab:attrib} 着色。上：两档关键链的构成；标题并列「被消除的走廊等待」与「实际收回的完工时间」，二者之差即被顶上来的约束吸收掉的部分。 下：同一条链在时间轴上的原位，表明上方的柱是一条链的分解，不是互不相关事件的直方图。 闭环解中 \texttt  {corridor} 大体消失，顶上来的是机械臂与上游工序。}}{32}{figure.caption.44}\protected@file@percent }
\newlabel{fig:case_chain}{{9}{32}{关键链各节按表~\ref {tab:attrib} 着色。上：两档关键链的构成；标题并列「被消除的走廊等待」与「实际收回的完工时间」，二者之差即被顶上来的约束吸收掉的部分。 下：同一条链在时间轴上的原位，表明上方的柱是一条链的分解，不是互不相关事件的直方图。 闭环解中 \texttt {corridor} 大体消失，顶上来的是机械臂与上游工序。}{figure.caption.44}{}}
