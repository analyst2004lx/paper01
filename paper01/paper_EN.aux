\@writefile{toc}{\contentsline {paragraph}{Heterogeneity does not raise the closed-loop gain.}{33}{section*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Surcharge on corridor--time slots. A positive value means worse. Under equal wall-clock time (left), the makespan worsening appears as soon as the surcharge is turned on, then stays flat over a ten-fold range of $\mittheta $, in step with the cost per evaluation on the right axis; under an equal number of evaluations (right), the worsening disappears. The damage comes from a higher cost per evaluation and hence fewer evaluations within the same budget, not from the surcharge choosing wrong paths. Markers are means and error bars are the standard error of the mean; the number of runs per point is given in the figure footer. ``Significant'' refers to a two-sided Wilcoxon signed-rank test of each $\mittheta $ against $\mittheta =0$, paired by seed. The two instances do not belong to the three families of Table\nonbreakingspace \ref {tab:instances}, and the legend labels \texttt  {high}/\texttt  {funnel} are layout tags only; see Table\nonbreakingspace \ref {tab:batches} for the batch.}}{34}{figure.caption.33}\protected@file@percent }
\newlabel{fig:theta}{{5}{34}{Surcharge on corridor--time slots. A positive value means worse. Under equal wall-clock time (left), the makespan worsening appears as soon as the surcharge is turned on, then stays flat over a ten-fold range of $\theta $, in step with the cost per evaluation on the right axis; under an equal number of evaluations (right), the worsening disappears. The damage comes from a higher cost per evaluation and hence fewer evaluations within the same budget, not from the surcharge choosing wrong paths. Markers are means and error bars are the standard error of the mean; the number of runs per point is given in the figure footer. ``Significant'' refers to a two-sided Wilcoxon signed-rank test of each $\theta $ against $\theta =0$, paired by seed. The two instances do not belong to the three families of Table~\ref {tab:instances}, and the legend labels \texttt {high}/\texttt {funnel} are layout tags only; see Table~\ref {tab:batches} for the batch}{figure.caption.33}{}}
