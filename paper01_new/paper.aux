\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Grid resolution sensitivity on DS2 (30 tasks). \textbf  {Left}: Computation time grows quadratically with finer grids (exponent 1.97). \textbf  {Right}: Makespan improves with finer resolution but plateaus at $\Delta x \approx 0.3$ m. The optimal choice is $\Delta x = 0.5$ m (red marker), balancing accuracy (3.2\% error) and speed (9.8 s).}}{23}{figure.caption.10}\protected@file@percent }
\newlabel{fig:grid_sensitivity}{{5}{23}{Grid resolution sensitivity on DS2 (30 tasks). \textbf {Left}: Computation time grows quadratically with finer grids (exponent 1.97). \textbf {Right}: Makespan improves with finer resolution but plateaus at $\Delta x \approx 0.3$ m. The optimal choice is $\Delta x = 0.5$ m (red marker), balancing accuracy (3.2\% error) and speed (9.8 s)}{figure.caption.10}{}}
