\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces HDP framework architecture. \textbf  {(A) Physical scenario}: Three AGVs (CSS agents, circles) deliver materials to three robotic arms RA1--RA3 (DES agents, rectangles). \textbf  {(B) Decompose--Coordinate--Converge}: The CDHAS problem is decomposed into CSS-DP (trajectory optimization) and DES-DP (task scheduling); the Coordinator iteratively exchanges arrival times $\mathbf  {t}^{(\ell )}$ and schedules $\bm  {\tau }^{(\ell +1)}$ until makespan improvement within a defined scope. \textbf  {(C) Iterative variable exchange}: CSS-DP computes arrival times given the current schedule, DES-DP updates the schedule given new arrival times, and the resulting makespan decreases monotonically.}}{10}{figure.caption.3}\protected@file@percent }
\newlabel{fig:hdp_framework}{{1}{10}{HDP framework architecture. \textbf {(A) Physical scenario}: Three AGVs (CSS agents, circles) deliver materials to three robotic arms RA1--RA3 (DES agents, rectangles). \textbf {(B) Decompose--Coordinate--Converge}: The CDHAS problem is decomposed into CSS-DP (trajectory optimization) and DES-DP (task scheduling); the Coordinator iteratively exchanges arrival times $\mathbf {t}^{(\ell )}$ and schedules $\boldsymbol {\tau }^{(\ell +1)}$ until makespan improvement within a defined scope. \textbf {(C) Iterative variable exchange}: CSS-DP computes arrival times given the current schedule, DES-DP updates the schedule given new arrival times, and the resulting makespan decreases monotonically}{figure.caption.3}{}}
