\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Solution quality vs.\ cumulative computation time on DS2 (30 tasks, log-scale time axis). HDP converges in 6 coordination rounds (9.8\,s) to a makespan of 86.3\,s, consistent with geometric decay at $\rho _{\text  {eff}}\approx 0.40$ (Theorem\nonbreakingspace \ref {thm:convergence}). MILP's data points represent Branch-and-Bound incumbent updates (intermediate feasible solutions \emph  {without} optimality guarantees); MILP times out at 3{,}600\,s before certifying optimality.}}{21}{figure.caption.7}\protected@file@percent }
\newlabel{fig:convergence}{{3}{21}{Solution quality vs.\ cumulative computation time on DS2 (30 tasks, log-scale time axis). HDP converges in 6 coordination rounds (9.8\,s) to a makespan of 86.3\,s, consistent with geometric decay at $\rho _{\text {eff}}\approx 0.40$ (Theorem~\ref {thm:convergence}). MILP's data points represent Branch-and-Bound incumbent updates (intermediate feasible solutions \emph {without} optimality guarantees); MILP times out at 3{,}600\,s before certifying optimality}{figure.caption.7}{}}
